DEFINE
    MEASURE _Medidas[AvisoSemFalta] =
        IF([TotalEventos] + 0 > 0 && [DiasSemDadoPublico] = 0, "Nenhum dia sem registro: os dados do público estão completos", "")
    MEASURE _Medidas[TodosNovo] = CALCULATE([ArtigosNaMarca], fato_serie_sensibilidade[corte_amplificacao] = 1, REMOVEFILTERS(fato_serie_sensibilidade[Marca da régua]))
    MEASURE _Medidas[DobraramNovo] = CALCULATE([ArtigosNaMarca], fato_serie_sensibilidade[corte_amplificacao] = 2, REMOVEFILTERS(fato_serie_sensibilidade[Marca da régua]))
    MEASURE _Medidas[TriplicaramNovo] = CALCULATE([ArtigosNaMarca], fato_serie_sensibilidade[corte_amplificacao] = 3, REMOVEFILTERS(fato_serie_sensibilidade[Marca da régua]))
    MEASURE _Medidas[CincoNovo] = CALCULATE([ArtigosNaMarca], fato_serie_sensibilidade[corte_amplificacao] = 5, REMOVEFILTERS(fato_serie_sensibilidade[Marca da régua]))
    MEASURE _Medidas[VantagemNovo] =
        VAR d = SELECTEDVALUE(fato_correlacao_defasagem[defasagem])
        RETURN IF(ISBLANK(d), BLANK(), CALCULATE(DISTINCTCOUNT(fato_defasagem_evento[id_evento]), fato_defasagem_evento[defasagem_otima] = d) + 0)
EVALUATE
UNION(
    ROW("Cenario", "1. Sem filtro", "Aviso", [AvisoSemFalta]),
    CALCULATETABLE(ROW("Cenario", "2. James Webb", "Aviso", [AvisoSemFalta]), dim_evento[Evento] = "Primeiras imagens do James Webb"),
    CALCULATETABLE(ROW("Cenario", "3. ChatGPT", "Aviso", [AvisoSemFalta]), dim_evento[Evento] = "ChatGPT"),
    CALCULATETABLE(ROW("Cenario", "4. Ciencia", "Aviso", [AvisoSemFalta]), dim_evento[Categoria do evento] = "Ciência")
)
EVALUATE
CALCULATETABLE(
    ROW("Todos antes", [ArtigosTodos], "Todos depois", [TodosNovo],
        "Dobraram depois", [DobraramNovo], "Triplicaram depois", [TriplicaramNovo], "Cinco depois", [CincoNovo]),
    dim_evento[Categoria do evento] = "Lançamento de produto",
    fato_serie_sensibilidade[Marca da régua] = "Dobraram"
)
EVALUATE
ROW("Vantagem antes, sem coluna", [EventosNaVantagem], "Vantagem depois, sem coluna", [VantagemNovo])