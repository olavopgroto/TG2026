DEFINE
    MEASURE _Medidas[MeiaVidaCartao] =
        VAR m = [MeiaVidaPublico]
        RETURN
            SWITCH(TRUE(),
                [TotalEventos] + 0 = 0, BLANK(),
                ISBLANK(m), "além da janela",
                m = 1, "1 dia",
                m = INT(m), FORMAT(m, "0", "pt-BR") & " dias",
                FORMAT(m, "0.0", "pt-BR") & " dias")
EVALUATE
UNION(
    ROW("Cenario", "1. Sem filtro", "Cartao", [MeiaVidaCartao]),
    CALCULATETABLE(ROW("Cenario", "2. Kobe Bryant", "Cartao", [MeiaVidaCartao]), dim_evento[Evento] = "Kobe Bryant"),
    CALCULATETABLE(ROW("Cenario", "3. Shinzo Abe", "Cartao", [MeiaVidaCartao]), dim_evento[Evento] = "Shinzo Abe"),
    CALCULATETABLE(ROW("Cenario", "4. ChatGPT", "Cartao", [MeiaVidaCartao]), dim_evento[Evento] = "ChatGPT"),
    CALCULATETABLE(ROW("Cenario", "5. Impossivel", "Cartao", [MeiaVidaCartao]),
        dim_evento[Resultado oficial] = "Chegaram juntos", dim_evento[Evento] = "Furacão Ian")
)