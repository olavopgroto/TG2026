DEFINE
    COLUMN dim_evento[t_nome] = SWITCH(dim_evento[nome_evento], "Enchentes Rio Grande do Sul", "Enchentes no Rio Grande do Sul", "Incendios Maui Havai", "Incêndios em Maui, Havaí", "Terremoto Noto Japao", "Terremoto em Noto, Japão", "Terremoto Myanmar", "Terremoto em Mianmar", "Terremoto Haiti", "Terremoto no Haiti", "Terremoto Al Haouz Marrocos", "Terremoto em Al Haouz, Marrocos", "Terremoto Turquia-Siria", "Terremoto na Turquia e na Síria", "Threads Meta", "Threads, da Meta", "Furacao Ian", "Furacão Ian", "Eleicao presidencial Brasil", "Eleição presidencial no Brasil", "Cupula G20 Nova Delhi", "Cúpula do G20 em Nova Délhi", "COP28 Dubai", "COP28 em Dubai", "Eleicao presidencial Mexico", "Eleição presidencial no México", "Eleicao geral India", "Eleição geral na Índia", "Eleicao presidencial EUA", "Eleição presidencial nos EUA", "Cupula G20 Rio", "Cúpula do G20 no Rio", "COP30 Belem", "COP30 em Belém", "Imagem Sagitario A", "Imagem de Sagitário A*", "Imagens James Webb", "Primeiras imagens do James Webb", "Impacto sonda DART", "Impacto da sonda DART", "Lancamento Artemis I", "Lançamento da Artemis I", "Ignicao fusao nuclear", "Ignição da fusão nuclear", "Primeiro voo Starship", "Primeiro voo da Starship", "Pouso Chandrayaan-3", "Pouso da Chandrayaan-3", "Pouso Perseverance Marte", "Pouso do Perseverance em Marte", "Pele", "Pelé", dim_evento[nome_evento])
EVALUATE
ROW("Eventos", COUNTROWS(dim_evento), "Nomes distintos", DISTINCTCOUNT(dim_evento[t_nome]), "Mudaram", COUNTROWS(FILTER(dim_evento, dim_evento[t_nome] <> dim_evento[nome_evento])))