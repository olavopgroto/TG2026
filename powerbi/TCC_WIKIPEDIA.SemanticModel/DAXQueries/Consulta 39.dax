DEFINE
    MEASURE _Medidas[SeloContexto] =
        VAR n = [TotalEventos] + 0
        VAR total = CALCULATE([TotalEventos], REMOVEFILTERS(dim_evento))
        VAR janela = " · de 30 dias antes a 60 depois"
        RETURN
            SWITCH(TRUE(),
                n = 0, "Nenhum evento nesta seleção · aperte limpar",
                n = 1, SELECTEDVALUE(dim_evento[Evento]) & janela,
                n = total, FORMAT(total, "0") & " eventos" & janela,
                FORMAT(n, "0") & " de " & FORMAT(total, "0") & " eventos" & janela)
    MEASURE _Medidas[CorSelo] = IF([TotalEventos] + 0 = 0, "#38BEE8", "#6B7686")
EVALUATE
UNION(
    ROW("Cenario", "1. Sem filtro", "Selo", [SeloContexto], "Cor", [CorSelo]),
    CALCULATETABLE(ROW("Cenario", "2. Politica", "Selo", [SeloContexto], "Cor", [CorSelo]), dim_evento[Categoria do evento] = "Política"),
    CALCULATETABLE(ROW("Cenario", "3. Barra picos", "Selo", [SeloContexto], "Cor", [CorSelo]), dim_evento[Resultado oficial] = "Picos em datas diferentes"),
    CALCULATETABLE(ROW("Cenario", "4. Furacao Ian", "Selo", [SeloContexto], "Cor", [CorSelo]), dim_evento[Evento] = "Furacão Ian"),
    CALCULATETABLE(ROW("Cenario", "5. Impossivel", "Selo", [SeloContexto], "Cor", [CorSelo]), dim_evento[Resultado oficial] = "Chegaram juntos", dim_evento[Evento] = "Furacão Ian")
)