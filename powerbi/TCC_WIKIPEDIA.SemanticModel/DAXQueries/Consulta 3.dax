EVALUATE
CALCULATETABLE(
    ROW("Todos", [ArtigosTodos], "Dobraram", [ArtigosDobraram], "Triplicaram", [ArtigosTriplicaram], "Cinco", [ArtigosCincoVezes]),
    dim_evento[Categoria do evento] = "Lançamento de produto",
    fato_serie_sensibilidade[Marca da régua] = "Dobraram"
)
