-- CON-01: a medida do cartao Sem conclusao, nas duas formas e por categoria
EVALUATE
UNION(
    ROW("Forma", "Curva inteira (oficial)", "SemConclusao", CALCULATE([QtdSemConclusao], DimEscala[Forma de comparar] = "Curva inteira (oficial)")),
    ROW("Forma", "Só o pico", "SemConclusao", CALCULATE([QtdSemConclusao], DimEscala[Forma de comparar] = "Só o pico"))
)
EVALUATE
CALCULATETABLE(
    SUMMARIZECOLUMNS(dim_evento[Categoria do evento], "SemConclusao", [QtdSemConclusao]),
    DimEscala[Forma de comparar] = "Curva inteira (oficial)"
)