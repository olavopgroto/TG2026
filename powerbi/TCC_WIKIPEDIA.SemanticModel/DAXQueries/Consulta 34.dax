EVALUATE
UNION(
    ROW("Cenario", "1. Sem filtro", "Eventos", [TotalEventos], "Periodo", [PeriodoTexto], "Visitas", [VisitasPublico], "Materias", [Materias]),
    CALCULATETABLE(ROW("Cenario", "2. Politica", "Eventos", [TotalEventos], "Periodo", [PeriodoTexto], "Visitas", [VisitasPublico], "Materias", [Materias]), dim_evento[Categoria do evento] = "Política"),
    CALCULATETABLE(ROW("Cenario", "3. Kobe Bryant", "Eventos", [TotalEventos], "Periodo", [PeriodoTexto], "Visitas", [VisitasPublico], "Materias", [Materias]), dim_evento[Evento] = "Kobe Bryant"),
    CALCULATETABLE(ROW("Cenario", "4. Kobe e Pele", "Eventos", [TotalEventos], "Periodo", [PeriodoTexto], "Visitas", [VisitasPublico], "Materias", [Materias]), dim_evento[Evento] IN {"Kobe Bryant", "Pelé"}),
    CALCULATETABLE(ROW("Cenario", "5. Coluna 2023", "Eventos", [TotalEventos], "Periodo", [PeriodoTexto], "Visitas", [VisitasPublico], "Materias", [Materias]), dim_evento[AnoEvento] = 2023),
    CALCULATETABLE(ROW("Cenario", "6. Ciencia em 2020", "Eventos", [TotalEventos], "Periodo", [PeriodoTexto], "Visitas", [VisitasPublico], "Materias", [Materias]), dim_evento[Categoria do evento] = "Ciência", dim_evento[AnoEvento] = 2020)
)
EVALUATE
CALCULATETABLE(SUMMARIZECOLUMNS(dim_evento[AnoEvento], "Eventos", [TotalEventos]), dim_evento[Categoria do evento] = "Política")
EVALUATE
TOPN(3, SUMMARIZECOLUMNS(dim_evento[Evento], dim_evento[data_evento]), dim_evento[data_evento], DESC)