table _Medidas
	lineageTag: 5a2ec08f-79f1-4b2f-b6e5-df2922368f72

	measure VisitasPublico = SUM(fato_serie_diaria[views_principal])
		formatString: #,0
		lineageTag: 69b9ed68-7d30-46dc-b346-d8e6b2f1e3c5

	measure Materias = SUM(fato_serie_diaria[materias])
		formatString: #,0
		lineageTag: 16d00780-f8f6-4603-aa9b-0e194564a9d5

	measure MeiaVidaContada = AVERAGE(fato_metricas_evento[meia_vida_observada])
		lineageTag: 93539d41-3417-4f28-a833-3ce1b4259d30

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure EventosSimultaneos = CALCULATE(DISTINCTCOUNT(fato_defasagem_evento[id_evento]), fato_defasagem_evento[leitura] = "simultaneo", fato_defasagem_evento[variante] = "nivel_log")
		formatString: 0
		lineageTag: 728766ff-a126-4d2e-b5be-63b8d96739fe

	measure TotalEventos = DISTINCTCOUNT(dim_evento[id_evento])
		formatString: 0
		lineageTag: ef5c3525-376d-45a3-a0e0-2227add9e2df

	measure PctPicoPublico = AVERAGE(fato_serie_diaria[pct_pico_publico])
		formatString: 0%;-0%;0%
		lineageTag: dc9e1a34-cf59-4856-bdfd-b2bc164adde3

	measure PctPicoImprensa = AVERAGE(fato_serie_diaria[pct_pico_midia])
		formatString: 0%;-0%;0%
		lineageTag: 9ac12537-413c-4300-9d79-346537146a54

	measure PctPicoRobos = AVERAGE(fato_serie_robos[pct_pico])
		formatString: 0%;-0%;0%
		lineageTag: a007593f-8e12-4dca-9460-2f45168a3a3a

	measure MeiaVidaAjustada = AVERAGE(fato_metricas_evento[meia_vida_fase1])
		lineageTag: aa5c2233-5a57-4d67-bdce-97990defaee6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure MeiaVidaRetaUnica = AVERAGE(fato_metricas_evento[meia_vida_simples])
		lineageTag: bcb77afb-1c7b-4703-887a-662e203f6438

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure MeiaVidaPublico = CALCULATE(AVERAGE(fato_metricas_evento[meia_vida_observada]), fato_metricas_evento[fonte] = "publico")
		lineageTag: c5008be9-3883-4207-881f-4bb24bdfe68d

		formatStringDefinition = "0.0 ""dias"""

	measure EventosPorLeitura = CALCULATE(DISTINCTCOUNT(fato_defasagem_evento[id_evento]), fato_defasagem_evento[variante] = "nivel_log")
		formatString: 0
		lineageTag: 65fe6f99-cdeb-48de-9c7b-eea7ea0aa958

	measure QtdJuntos = CALCULATE(DISTINCTCOUNT(fato_defasagem_evento[id_evento]), fato_defasagem_evento[leitura] = "simultaneo") + 0
		formatString: 0
		lineageTag: dff2037b-6337-4a86-a477-0fa72435cb24

	measure QtdImprensaFrente = CALCULATE(DISTINCTCOUNT(fato_defasagem_evento[id_evento]), fato_defasagem_evento[leitura] = "midia_antes") + 0
		formatString: 0
		lineageTag: 59e402c1-6e10-46a9-b608-4ca220e044d4

	measure QtdPublicoFrente = CALCULATE(DISTINCTCOUNT(fato_defasagem_evento[id_evento]), fato_defasagem_evento[leitura] = "publico_antes") + 0
		formatString: 0
		lineageTag: d50e1b0e-22f1-421a-835c-5cbaddd55e21

	measure QtdConcordam = CALCULATE(DISTINCTCOUNT(fato_defasagem_evento[id_evento]), fato_defasagem_evento[concorda_com_lag_por_pico] = TRUE()) + 0
		formatString: 0
		lineageTag: dc09cd76-070e-4ed7-816e-0085cfbd005a

	measure ConcordamDeTotal = FORMAT([QtdConcordam], "0") & " de " & FORMAT([TotalEventos], "0")
		lineageTag: e639dc08-ec33-464b-9bf8-6514d37e3a90

	measure EventosNaEscala = DISTINCTCOUNT(fato_defasagem_evento[id_evento])
		formatString: 0
		lineageTag: bf5f7699-4818-4ced-95d5-f244434dcae1

	measure CorrelacaoEvento = IF(HASONEVALUE(dim_evento[id_evento]) && HASONEVALUE(DimEscala[variante]), AVERAGE(fato_correlacao_defasagem[correlacao]))
		lineageTag: 974b7c49-6553-4f43-af94-cefadf0667d9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure LimiteSignificancia = IF(HASONEVALUE(dim_evento[id_evento]) && HASONEVALUE(DimEscala[variante]), AVERAGE(fato_correlacao_defasagem[limite_critico]))
		lineageTag: 5c68c4bc-18a7-4be2-b237-7feb85f6d1c7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure JuntosDeTotal = FORMAT([QtdJuntos], "0") & " de " & FORMAT([TotalEventos], "0")
		lineageTag: 26661547-e2ae-47c1-af76-58b76f652717

	partition _Medidas = m
		mode: import
		source =
				let
				    Fonte = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [#"Coluna 1" = _t]),
				    #"Tipo Alterado" = Table.TransformColumnTypes(Fonte,{{"Coluna 1", type text}}),
				    #"Colunas Removidas" = Table.RemoveColumns(#"Tipo Alterado",{"Coluna 1"})
				in
