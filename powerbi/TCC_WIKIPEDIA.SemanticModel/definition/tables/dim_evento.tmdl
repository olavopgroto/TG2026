	column AnoEvento = YEAR(dim_evento[data_evento])
		formatString: 0
		lineageTag: 98635ea4-82b2-41fb-ab4f-968685098c2e
		summarizeBy: none

		annotation SummarizationSetBy = User

	column 'Categoria do evento' = SWITCH(dim_evento[categoria], "ciencia_global", "Ciência", "desastre_natural", "Desastre natural", "lancamento_produto", "Lançamento de produto", "morte_figura_publica", "Morte de figura pública", "politico", "Político")
		lineageTag: ee34cbcf-5f21-496b-9e45-15e8bb52183d
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Artigo criado' = VAR d = INT(dim_evento[data_criacao_principal] - dim_evento[data_evento]) RETURN SWITCH(TRUE(), ISBLANK(dim_evento[data_criacao_principal]), "sem data", d < 0, "antes do evento", d = 0, "no dia do evento", d = 1, "1 dia depois", FORMAT(d, "0") & " dias depois")
		lineageTag: 0e437b55-1479-4d88-b969-8e0d0277f5d1
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition dim_evento = m
		mode: import
		source =
				let
				    Fonte = PostgreSQL.Database("localhost:5432", "tcc_wikipedia"),
				    gold_dim_evento = Fonte{[Schema="gold",Item="dim_evento"]}[Data]
				in
				    gold_dim_evento

	changedProperty = Name

	annotation PBI_ResultType = Table

