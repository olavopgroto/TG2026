	column AnoEvento = YEAR(dim_evento[data_evento])
		formatString: 0
		lineageTag: 98635ea4-82b2-41fb-ab4f-968685098c2e
		summarizeBy: none

		annotation SummarizationSetBy = User

	column 'Categoria do evento' = SWITCH(dim_evento[categoria], "ciencia_global", "Ciência", "desastre_natural", "Desastre natural", "lancamento_produto", "Lançamento de produto", "morte_figura_publica", "Morte de figura pública", "politico", "Política")
		lineageTag: ee34cbcf-5f21-496b-9e45-15e8bb52183d
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Artigo criado' = VAR d = INT(dim_evento[data_criacao_principal] - dim_evento[data_evento]) RETURN SWITCH(TRUE(), ISBLANK(dim_evento[data_criacao_principal]), "sem data", d < -30, "mais de 30 dias antes", d < -1, FORMAT(-d, "0") & " dias antes", d = -1, "1 dia antes", d = 0, "no dia do evento", d = 1, "1 dia depois", FORMAT(d, "0") & " dias depois")
		lineageTag: 0e437b55-1479-4d88-b969-8e0d0277f5d1
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Evento = SWITCH(dim_evento[nome_evento], "Enchentes Rio Grande do Sul", "Enchentes no Rio Grande do Sul", "Incendios Maui Havai", "Incêndios em Maui, Havaí", "Terremoto Noto Japao", "Terremoto em Noto, Japão", "Terremoto Myanmar", "Terremoto em Mianmar", "Terremoto Haiti", "Terremoto no Haiti", "Terremoto Al Haouz Marrocos", "Terremoto em Al Haouz, Marrocos", "Terremoto Turquia-Siria", "Terremoto na Turquia e na Síria", "Threads Meta", "Threads, da Meta", "Furacao Ian", "Furacão Ian", "Eleicao presidencial Brasil", "Eleição presidencial no Brasil", "Cupula G20 Nova Delhi", "Cúpula do G20 em Nova Délhi", "COP28 Dubai", "COP28 em Dubai", "Eleicao presidencial Mexico", "Eleição presidencial no México", "Eleicao geral India", "Eleição geral na Índia", "Eleicao presidencial EUA", "Eleição presidencial nos EUA", "Cupula G20 Rio", "Cúpula do G20 no Rio", "COP30 Belem", "COP30 em Belém", "Imagem Sagitario A", "Imagem de Sagitário A*", "Imagens James Webb", "Primeiras imagens do James Webb", "Impacto sonda DART", "Impacto da sonda DART", "Lancamento Artemis I", "Lançamento da Artemis I", "Ignicao fusao nuclear", "Ignição da fusão nuclear", "Primeiro voo Starship", "Primeiro voo da Starship", "Pouso Chandrayaan-3", "Pouso da Chandrayaan-3", "Pouso Perseverance Marte", "Pouso do Perseverance em Marte", "Pele", "Pelé", dim_evento[nome_evento])
		lineageTag: 45a5628e-c6d2-4663-8798-7cb7eb63437c
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Motivo da falta' = VAR semDado = CALCULATE(COUNTROWS(FILTER(fato_serie_diaria, ISBLANK(fato_serie_diaria[views_principal])))) + 0 VAR rel = INT(dim_evento[data_criacao_principal] - dim_evento[data_evento]) VAR depois = CALCULATE(COUNTROWS(FILTER(fato_serie_diaria, ISBLANK(fato_serie_diaria[views_principal]) && fato_serie_diaria[dias_desde_evento] >= rel))) + 0 RETURN SWITCH(TRUE(), semDado = 0, "Nada falta", depois > 0, "A página existia, sem visitas registradas", "O artigo ainda não existia")
		lineageTag: 6119cb4b-14fc-4667-ad84-ee4fc318a127
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition dim_evento = m
		mode: import
		source =
				let
				    Fonte = PostgreSQL.Database("localhost:5432", "tcc_wikipedia"),
				    gold_dim_evento = Fonte{[Schema="gold",Item="dim_evento"]}[Data]
				in
				    gold_dim_evento

	changedProperty = Name

	annotation PBI_ResultType = Table

