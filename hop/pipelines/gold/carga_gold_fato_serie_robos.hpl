<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>carga_gold_fato_serie_robos</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Carrega gold.fato_serie_robos: a mesma curva do artigo principal, para os agentes spider e automated. Serve de controle, mostrando que os robos nao reagem ao evento. Grao evento x dia x agente, 7.280 linhas.</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/09/29 13:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/09/29 13:00:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>Ler as curvas dos robos</from>
      <to>Aplicar as regras da serie</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Aplicar as regras da serie</from>
      <to>Gravar gold.fato_serie_robos</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Ler as curvas dos robos</name>
    <type>TableInput</type>
    <description>Soma os tres tipos de acesso para cada um dos dois agentes de robo e traz o pico de cada curva, calculado por evento e por agente sobre a janela inteira. O LEFT JOIN do pico protege o caso de uma curva inteira sem dado, que geraria pico nulo em vez de sumir com as linhas.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>postgres</connection>
    <sql>WITH robos AS (
    -- soma dos tres tipos de acesso, por evento, dia e agente de robo
    SELECT id_evento,
           dia,
           dias_desde_evento,
           tipo_agente,
           SUM(views_principal)::bigint AS views_principal
    FROM silver.pageviews_diario_evento
    WHERE tipo_agente IN ('spider', 'automated')
    GROUP BY id_evento, dia, dias_desde_evento, tipo_agente
),
pico_robos AS (
    -- maior valor de cada curva; empate fica com o dia mais cedo
    SELECT DISTINCT ON (id_evento, tipo_agente)
           id_evento,
           tipo_agente,
           views_principal AS pico_robo
    FROM robos
    WHERE views_principal IS NOT NULL
    ORDER BY id_evento, tipo_agente, views_principal DESC NULLS LAST, dias_desde_evento
)
SELECT r.id_evento,
       r.dia,
       r.dias_desde_evento,
       r.tipo_agente,
       r.views_principal,
       pr.pico_robo
FROM robos r
LEFT JOIN pico_robos pr
       ON pr.id_evento   = r.id_evento
      AND pr.tipo_agente = r.tipo_agente
ORDER BY r.id_evento, r.tipo_agente, r.dia</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <attributes/>
    <GUI>
      <xloc>144</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Aplicar as regras da serie</name>
    <type>Janino</type>
    <description>As mesmas duas regras da serie do publico: o nulo vira zero na coluna tratada e a curva e dividida pelo proprio pico. Cada teste de nulo em um ternario separado, porque o Janino nao protege contra nulo dentro de expressao composta.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <formula>
      <field_name>views_principal_tratado</field_name>
      <formula_string>views_principal == null ? Long.valueOf(0) : views_principal</formula_string>
      <value_type>Integer</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>pct_pico</field_name>
      <formula_string>views_principal == null ? (Double) null : (pico_robo == null ? (Double) null : (pico_robo.longValue() == 0 ? (Double) null : Double.valueOf(views_principal.doubleValue() / pico_robo.doubleValue())))</formula_string>
      <value_type>Number</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <attributes/>
    <GUI>
      <xloc>384</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Gravar gold.fato_serie_robos</name>
    <type>TableOutput</type>
    <description>Grava as 7.280 linhas. O campo pico_robo fica de fora porque a gravacao lista os campos um a um.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <commit>1000</commit>
    <connection>postgres</connection>
    <fields>
      <field>
        <column_name>id_evento</column_name>
        <stream_name>id_evento</stream_name>
      </field>
      <field>
        <column_name>dia</column_name>
        <stream_name>dia</stream_name>
      </field>
      <field>
        <column_name>dias_desde_evento</column_name>
        <stream_name>dias_desde_evento</stream_name>
      </field>
      <field>
        <column_name>tipo_agente</column_name>
        <stream_name>tipo_agente</stream_name>
      </field>
      <field>
        <column_name>views_principal</column_name>
        <stream_name>views_principal</stream_name>
      </field>
      <field>
        <column_name>views_principal_tratado</column_name>
        <stream_name>views_principal_tratado</stream_name>
      </field>
      <field>
        <column_name>pct_pico</column_name>
        <stream_name>pct_pico</stream_name>
      </field>
    </fields>
    <ignore_errors>N</ignore_errors>
    <only_when_have_rows>N</only_when_have_rows>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_field/>
    <partitioning_monthly>Y</partitioning_monthly>
    <return_field/>
    <return_keys>N</return_keys>
    <schema>gold</schema>
    <specify_fields>Y</specify_fields>
    <table>fato_serie_robos</table>
    <tablename_field/>
    <tablename_in_field>N</tablename_in_field>
    <tablename_in_table>Y</tablename_in_table>
    <truncate>N</truncate>
    <use_batch>Y</use_batch>
    <attributes/>
    <GUI>
      <xloc>624</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>
