<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>carga_gold_fato_serie_diaria</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Carrega gold.fato_serie_diaria: as duas curvas de atencao por evento e dia, com o agente user e os tres tipos de acesso somados, ja normalizadas pelo pico de cada serie. Grao evento x dia, 3.640 linhas.</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/09/29 12:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/09/29 12:00:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>Ler as duas series da Silver</from>
      <to>Aplicar as regras da serie</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Aplicar as regras da serie</from>
      <to>Gravar gold.fato_serie_diaria</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Ler as duas series da Silver</name>
    <type>TableInput</type>
    <description>Soma os tres tipos de acesso do agente user, junta com a cobertura do mesmo dia e traz o valor e o dia do pico de cada serie, calculados sobre a janela inteira de -30 a +60. A ordenacao do pico usa DESC NULLS LAST, porque no PostgreSQL o nulo vem primeiro em ordem decrescente e seria tomado como maior valor.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>postgres</connection>
    <sql>WITH publico AS (
    -- soma dos tres tipos de acesso do agente user, por evento e dia
    SELECT id_evento,
           dia,
           dias_desde_evento,
           SUM(views_principal)::bigint  AS views_principal,
           SUM(views_conjunto)::bigint   AS views_conjunto,
           MAX(artigos_com_dado)::int    AS artigos_com_dado
    FROM silver.pageviews_diario_evento
    WHERE tipo_agente = 'user'
    GROUP BY id_evento, dia, dias_desde_evento
),
pico_publico AS (
    -- maior valor da curva do publico e em que dia ele ocorreu; empate fica com o dia mais cedo
    SELECT DISTINCT ON (id_evento)
           id_evento,
           views_principal   AS pico_publico,
           dias_desde_evento AS dia_pico_publico
    FROM publico
    WHERE views_principal IS NOT NULL
    ORDER BY id_evento, views_principal DESC NULLS LAST, dias_desde_evento
),
pico_midia AS (
    -- maior volume diario de materias e em que dia ele ocorreu
    SELECT DISTINCT ON (id_evento)
           id_evento,
           materias          AS pico_midia,
           dias_desde_evento AS dia_pico_midia
    FROM silver.cobertura_diaria
    ORDER BY id_evento, materias DESC NULLS LAST, dias_desde_evento
)
SELECT p.id_evento,
       p.dia,
       p.dias_desde_evento,
       p.views_principal,
       p.views_conjunto,
       p.artigos_com_dado,
       c.materias,
       c.paises_com_materia,
       pp.pico_publico,
       pp.dia_pico_publico,
       pm.pico_midia,
       pm.dia_pico_midia
FROM publico p
JOIN silver.cobertura_diaria c ON c.id_evento = p.id_evento AND c.dia = p.dia
JOIN pico_publico  pp ON pp.id_evento = p.id_evento
JOIN pico_midia    pm ON pm.id_evento = p.id_evento
ORDER BY p.id_evento, p.dia</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <attributes/>
    <GUI>
      <xloc>144</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Aplicar as regras da serie</name>
    <type>Janino</type>
    <description>As tres regras da camada: o nulo vira zero apenas na serie usada pela correlacao; cada curva e dividida pelo proprio pico, virando percentual; e o eixo de tempo passa a contar a partir do pico, e nao da data do evento. Cada teste de nulo e feito em ternario separado, porque o Janino nao protege contra nulo dentro de uma expressao composta.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <formula>
      <field_name>views_principal_tratado</field_name>
      <formula_string>views_principal == null ? Long.valueOf(0) : views_principal</formula_string>
      <value_type>Integer</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>pct_pico_publico</field_name>
      <formula_string>views_principal == null ? (Double) null : (pico_publico == null ? (Double) null : (pico_publico.longValue() == 0 ? (Double) null : Double.valueOf(views_principal.doubleValue() / pico_publico.doubleValue())))</formula_string>
      <value_type>Number</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>pct_pico_midia</field_name>
      <formula_string>pico_midia == null ? (Double) null : (pico_midia.longValue() == 0 ? (Double) null : Double.valueOf(materias.doubleValue() / pico_midia.doubleValue()))</formula_string>
      <value_type>Number</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>dias_desde_pico_publico</field_name>
      <formula_string>dias_desde_evento.longValue() - dia_pico_publico.longValue()</formula_string>
      <value_type>Integer</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>dias_desde_pico_midia</field_name>
      <formula_string>dias_desde_evento.longValue() - dia_pico_midia.longValue()</formula_string>
      <value_type>Integer</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <attributes/>
    <GUI>
      <xloc>384</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Gravar gold.fato_serie_diaria</name>
    <type>TableOutput</type>
    <description>Grava as 3.640 linhas. Os campos de apoio (pico_publico, dia_pico_publico, pico_midia, dia_pico_midia) ficam de fora porque a gravacao lista os campos um a um: eles voltam na fato_metricas_evento, que e onde o pico e metrica.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <commit>1000</commit>
    <connection>postgres</connection>
    <fields>
      <field>
        <column_name>id_evento</column_name>
        <stream_name>id_evento</stream_name>
      </field>
      <field>
        <column_name>dia</column_name>
        <stream_name>dia</stream_name>
      </field>
      <field>
        <column_name>dias_desde_evento</column_name>
        <stream_name>dias_desde_evento</stream_name>
      </field>
      <field>
        <column_name>views_principal</column_name>
        <stream_name>views_principal</stream_name>
      </field>
      <field>
        <column_name>views_conjunto</column_name>
        <stream_name>views_conjunto</stream_name>
      </field>
      <field>
        <column_name>views_principal_tratado</column_name>
        <stream_name>views_principal_tratado</stream_name>
      </field>
      <field>
        <column_name>artigos_com_dado</column_name>
        <stream_name>artigos_com_dado</stream_name>
      </field>
      <field>
        <column_name>materias</column_name>
        <stream_name>materias</stream_name>
      </field>
      <field>
        <column_name>paises_com_materia</column_name>
        <stream_name>paises_com_materia</stream_name>
      </field>
      <field>
        <column_name>pct_pico_publico</column_name>
        <stream_name>pct_pico_publico</stream_name>
      </field>
      <field>
        <column_name>pct_pico_midia</column_name>
        <stream_name>pct_pico_midia</stream_name>
      </field>
      <field>
        <column_name>dias_desde_pico_publico</column_name>
        <stream_name>dias_desde_pico_publico</stream_name>
      </field>
      <field>
        <column_name>dias_desde_pico_midia</column_name>
        <stream_name>dias_desde_pico_midia</stream_name>
      </field>
    </fields>
    <ignore_errors>N</ignore_errors>
    <only_when_have_rows>N</only_when_have_rows>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_field/>
    <partitioning_monthly>Y</partitioning_monthly>
    <return_field/>
    <return_keys>N</return_keys>
    <schema>gold</schema>
    <specify_fields>Y</specify_fields>
    <table>fato_serie_diaria</table>
    <tablename_field/>
    <tablename_in_field>N</tablename_in_field>
    <tablename_in_table>Y</tablename_in_table>
    <truncate>N</truncate>
    <use_batch>Y</use_batch>
    <attributes/>
    <GUI>
      <xloc>624</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>
