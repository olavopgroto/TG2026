<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>carga_gold_dim_evento</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Carrega gold.dim_evento a partir da Silver: os atributos descritivos dos 40 eventos mais cinco contagens de qualidade. A unica regra de decisao da tabela fica no transform de classificacao.</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/09/29 10:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/09/29 10:00:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>Ler eventos e contagens da Silver</from>
      <to>Classificar a criacao do principal</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Classificar a criacao do principal</from>
      <to>Gravar gold.dim_evento</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Ler eventos e contagens da Silver</name>
    <type>TableInput</type>
    <description>Le os 40 eventos e conta, no banco, o que precisa varrer as tabelas grandes da Silver: artigos, aliases, dias sem dado no principal, paises sem materia e dias com materia apos o evento. Contagem e trabalho de banco; a regra de decisao da tabela fica no transform seguinte.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>postgres</connection>
    <sql>WITH artigos_por_evento AS (
    -- quantos titulos o evento tem, separando os titulos anteriores do principal
    SELECT id_evento,
           COUNT(*) FILTER (WHERE alias_de IS NULL)     AS qtd_artigos,
           COUNT(*) FILTER (WHERE alias_de IS NOT NULL) AS qtd_aliases
    FROM silver.artigos
    GROUP BY id_evento
),
principal_por_evento AS (
    -- data da primeira revisao do artigo principal
    SELECT id_evento,
           MIN(data_criacao) AS data_criacao_principal
    FROM silver.artigos
    WHERE eh_principal
    GROUP BY id_evento
),
dias_sem_dado AS (
    -- dias, a partir do evento, em que nenhum acesso do agente user trouxe valor
    SELECT id_evento,
           COUNT(*) AS dias_sem_dado_principal
    FROM (
        SELECT id_evento, dia
        FROM silver.pageviews_diario_evento
        WHERE tipo_agente = 'user'
          AND dias_desde_evento &gt;= 0
        GROUP BY id_evento, dia
        HAVING COUNT(views_principal) = 0
    ) AS d
    GROUP BY id_evento
),
paises_zerados AS (
    -- colecoes nacionais que nao publicaram nenhuma materia na janela inteira
    SELECT id_evento,
           COUNT(*) AS paises_sem_materia
    FROM (
        SELECT id_evento, pais_cobertura
        FROM silver.cobertura_diaria_pais
        GROUP BY id_evento, pais_cobertura
        HAVING SUM(materias) = 0
    ) AS p
    GROUP BY id_evento
),
cobertura_pos_evento AS (
    -- dias com pelo menos uma materia do dia do evento em diante
    SELECT id_evento,
           COUNT(*) AS dias_com_materia_pos_evento
    FROM silver.cobertura_diaria
    WHERE dias_desde_evento &gt;= 0
      AND materias &gt; 0
    GROUP BY id_evento
)
SELECT e.id_evento,
       e.nome_evento,
       e.categoria,
       e.data_evento,
       e.artigo_principal,
       e.palavra_chave_busca,
       e.data_inicio_extracao                       AS data_inicio_janela,
       e.data_fim_extracao                          AS data_fim_janela,
       a.qtd_artigos,
       a.qtd_aliases,
       pr.data_criacao_principal,
       COALESCE(sd.dias_sem_dado_principal, 0)      AS dias_sem_dado_principal,
       COALESCE(pz.paises_sem_materia, 0)           AS paises_sem_materia,
       COALESCE(cp.dias_com_materia_pos_evento, 0)  AS dias_com_materia_pos_evento
FROM silver.eventos e
JOIN artigos_por_evento     a  ON a.id_evento  = e.id_evento
JOIN principal_por_evento   pr ON pr.id_evento = e.id_evento
LEFT JOIN dias_sem_dado     sd ON sd.id_evento = e.id_evento
LEFT JOIN paises_zerados    pz ON pz.id_evento = e.id_evento
LEFT JOIN cobertura_pos_evento cp ON cp.id_evento = e.id_evento
ORDER BY e.id_evento</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <attributes/>
    <GUI>
      <xloc>144</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Classificar a criacao do principal</name>
    <type>Janino</type>
    <description>Marca os eventos cujo artigo principal nasceu no dia do evento ou depois. E a regra que explica por que esses eventos nao tem linha de base de atencao publica. O teste do nulo vem primeiro porque o Janino nao protege contra nulo em expressao composta.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <formula>
      <field_name>principal_criado_apos_evento</field_name>
      <formula_string>data_criacao_principal == null ? Boolean.FALSE : (data_criacao_principal.before(data_evento) ? Boolean.FALSE : Boolean.TRUE)</formula_string>
      <value_type>Boolean</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <attributes/>
    <GUI>
      <xloc>384</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Gravar gold.dim_evento</name>
    <type>TableOutput</type>
    <description>Grava as 40 linhas da dimensao principal do modelo.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <commit>1000</commit>
    <connection>postgres</connection>
    <fields>
      <field>
        <column_name>id_evento</column_name>
        <stream_name>id_evento</stream_name>
      </field>
      <field>
        <column_name>nome_evento</column_name>
        <stream_name>nome_evento</stream_name>
      </field>
      <field>
        <column_name>categoria</column_name>
        <stream_name>categoria</stream_name>
      </field>
      <field>
        <column_name>data_evento</column_name>
        <stream_name>data_evento</stream_name>
      </field>
      <field>
        <column_name>artigo_principal</column_name>
        <stream_name>artigo_principal</stream_name>
      </field>
      <field>
        <column_name>palavra_chave_busca</column_name>
        <stream_name>palavra_chave_busca</stream_name>
      </field>
      <field>
        <column_name>data_inicio_janela</column_name>
        <stream_name>data_inicio_janela</stream_name>
      </field>
      <field>
        <column_name>data_fim_janela</column_name>
        <stream_name>data_fim_janela</stream_name>
      </field>
      <field>
        <column_name>qtd_artigos</column_name>
        <stream_name>qtd_artigos</stream_name>
      </field>
      <field>
        <column_name>qtd_aliases</column_name>
        <stream_name>qtd_aliases</stream_name>
      </field>
      <field>
        <column_name>data_criacao_principal</column_name>
        <stream_name>data_criacao_principal</stream_name>
      </field>
      <field>
        <column_name>principal_criado_apos_evento</column_name>
        <stream_name>principal_criado_apos_evento</stream_name>
      </field>
      <field>
        <column_name>dias_sem_dado_principal</column_name>
        <stream_name>dias_sem_dado_principal</stream_name>
      </field>
      <field>
        <column_name>paises_sem_materia</column_name>
        <stream_name>paises_sem_materia</stream_name>
      </field>
      <field>
        <column_name>dias_com_materia_pos_evento</column_name>
        <stream_name>dias_com_materia_pos_evento</stream_name>
      </field>
    </fields>
    <ignore_errors>N</ignore_errors>
    <only_when_have_rows>N</only_when_have_rows>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_field/>
    <partitioning_monthly>Y</partitioning_monthly>
    <return_field/>
    <return_keys>N</return_keys>
    <schema>gold</schema>
    <specify_fields>Y</specify_fields>
    <table>dim_evento</table>
    <tablename_field/>
    <tablename_in_field>N</tablename_in_field>
    <tablename_in_table>Y</tablename_in_table>
    <truncate>N</truncate>
    <use_batch>Y</use_batch>
    <attributes/>
    <GUI>
      <xloc>608</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>
