<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>carga_gold_fato_serie_sensibilidade</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Carrega gold.fato_serie_sensibilidade: a curva do conjunto de artigos recalculada em quatro cortes de amplificacao (1x, 2x, 3x e 5x). Grao evento x dia x corte, 14.560 linhas.</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/09/29 13:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/09/29 13:00:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>Montar as curvas por corte</from>
      <to>Normalizar pelo pico</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Normalizar pelo pico</from>
      <to>Gravar gold.fato_serie_sensibilidade</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Montar as curvas por corte</name>
    <type>TableInput</type>
    <description>Para cada corte, seleciona os artigos elegiveis e soma a serie deles. Regra do corte: entram os artigos com razao de amplificacao igual ou acima do corte, e o artigo principal e seus titulos anteriores entram sempre, independente da razao. O corte 1x inclui todos os artigos do evento, inclusive os sem razao medida.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>postgres</connection>
    <sql>WITH cortes AS (
    SELECT * FROM (VALUES (1.0), (2.0), (3.0), (5.0)) AS c(corte)
),
elegiveis AS (
    -- quais artigos entram em cada corte
    SELECT a.id_artigo,
           a.id_evento,
           c.corte
    FROM silver.artigos a
    CROSS JOIN cortes c
    WHERE c.corte = 1.0
       OR a.eh_principal
       OR a.alias_de IS NOT NULL
       OR (a.razao_amplificacao IS NOT NULL AND a.razao_amplificacao &gt;= c.corte)
),
artigos_por_corte AS (
    SELECT id_evento, corte, COUNT(*)::int AS artigos_no_corte
    FROM elegiveis
    GROUP BY id_evento, corte
),
serie AS (
    -- soma dos tres tipos de acesso do agente user, so dos artigos elegiveis
    SELECT el.id_evento,
           el.corte,
           p.dia,
           p.dias_desde_evento,
           SUM(p.visualizacoes)::bigint AS views_conjunto
    FROM elegiveis el
    JOIN silver.pageviews_diario_artigo p ON p.id_artigo = el.id_artigo
    WHERE p.tipo_agente = 'user'
    GROUP BY el.id_evento, el.corte, p.dia, p.dias_desde_evento
),
pico_corte AS (
    -- maior valor de cada curva, por evento e corte; empate fica com o dia mais cedo
    SELECT DISTINCT ON (id_evento, corte)
           id_evento,
           corte,
           views_conjunto AS pico_corte
    FROM serie
    WHERE views_conjunto IS NOT NULL
    ORDER BY id_evento, corte, views_conjunto DESC NULLS LAST, dias_desde_evento
)
SELECT s.id_evento,
       s.dia,
       s.dias_desde_evento,
       s.corte,
       s.views_conjunto,
       ac.artigos_no_corte,
       pc.pico_corte
FROM serie s
JOIN artigos_por_corte ac ON ac.id_evento = s.id_evento AND ac.corte = s.corte
LEFT JOIN pico_corte    pc ON pc.id_evento = s.id_evento AND pc.corte = s.corte
ORDER BY s.id_evento, s.corte, s.dia</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <attributes/>
    <GUI>
      <xloc>144</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Normalizar pelo pico</name>
    <type>Janino</type>
    <description>Divide cada dia pelo pico da propria curva, que aqui e o pico daquele corte, e nao o pico do evento. Assim as quatro curvas do mesmo evento podem ser comparadas entre si em percentual. Cada teste de nulo em um ternario separado, porque o Janino nao protege contra nulo dentro de expressao composta.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <formula>
      <field_name>pct_pico</field_name>
      <formula_string>views_conjunto == null ? (Double) null : (pico_corte == null ? (Double) null : (pico_corte.longValue() == 0 ? (Double) null : Double.valueOf(views_conjunto.doubleValue() / pico_corte.doubleValue())))</formula_string>
      <value_type>Number</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <attributes/>
    <GUI>
      <xloc>384</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Gravar gold.fato_serie_sensibilidade</name>
    <type>TableOutput</type>
    <description>Grava as 14.560 linhas. O campo pico_corte fica de fora porque a gravacao lista os campos um a um.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <commit>1000</commit>
    <connection>postgres</connection>
    <fields>
      <field>
        <column_name>id_evento</column_name>
        <stream_name>id_evento</stream_name>
      </field>
      <field>
        <column_name>dia</column_name>
        <stream_name>dia</stream_name>
      </field>
      <field>
        <column_name>dias_desde_evento</column_name>
        <stream_name>dias_desde_evento</stream_name>
      </field>
      <field>
        <column_name>corte_amplificacao</column_name>
        <stream_name>corte</stream_name>
      </field>
      <field>
        <column_name>views_conjunto</column_name>
        <stream_name>views_conjunto</stream_name>
      </field>
      <field>
        <column_name>artigos_no_corte</column_name>
        <stream_name>artigos_no_corte</stream_name>
      </field>
      <field>
        <column_name>pct_pico</column_name>
        <stream_name>pct_pico</stream_name>
      </field>
    </fields>
    <ignore_errors>N</ignore_errors>
    <only_when_have_rows>N</only_when_have_rows>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_field/>
    <partitioning_monthly>Y</partitioning_monthly>
    <return_field/>
    <return_keys>N</return_keys>
    <schema>gold</schema>
    <specify_fields>Y</specify_fields>
    <table>fato_serie_sensibilidade</table>
    <tablename_field/>
    <tablename_in_field>N</tablename_in_field>
    <tablename_in_table>Y</tablename_in_table>
    <truncate>N</truncate>
    <use_batch>Y</use_batch>
    <attributes/>
    <GUI>
      <xloc>624</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>
