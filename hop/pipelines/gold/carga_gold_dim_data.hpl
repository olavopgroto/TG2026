<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>carga_gold_dim_data</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Gera o calendario continuo de 2019-12-01 a 2026-01-31 e carrega gold.dim_data. Nenhuma leitura de banco: a tabela e derivada apenas de datas.</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/09/26 10:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/09/26 10:00:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>Gerar 2254 linhas</from>
      <to>Numerar os dias</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Numerar os dias</from>
      <to>Calcular a data e suas partes</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Calcular a data e suas partes</from>
      <to>Montar rotulos de texto</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Montar rotulos de texto</from>
      <to>Traduzir o mes</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Traduzir o mes</from>
      <to>Traduzir o dia da semana</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Traduzir o dia da semana</from>
      <to>Gravar gold.dim_data</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Gerar 2254 linhas</name>
    <type>RowGenerator</type>
    <description>Uma linha por dia do calendario. A data base e a primeira do periodo e o campo um e a constante usada na conversao do dia da semana.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <name>data_base</name>
        <type>Date</type>
        <format>yyyy-MM-dd</format>
        <nullif>2019-12-01</nullif>
        <length>-1</length>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
        <set_empty_string>N</set_empty_string>
      </field>
      <field>
        <name>um</name>
        <type>Integer</type>
        <format>#</format>
        <nullif>1</nullif>
        <length>-1</length>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
        <set_empty_string>N</set_empty_string>
      </field>
    </fields>
    <interval_in_ms>5000</interval_in_ms>
    <last_time_field>FiveSecondsAgo</last_time_field>
    <limit>2254</limit>
    <never_ending>N</never_ending>
    <row_time_field>now</row_time_field>
    <attributes/>
    <GUI>
      <xloc>112</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Numerar os dias</name>
    <type>Sequence</type>
    <description>Contador em memoria de 0 a 2253. E o deslocamento em dias a partir da data base.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <valuename>offset_dias</valuename>
    <use_database>N</use_database>
    <connection/>
    <schema/>
    <seqname>SEQ_</seqname>
    <use_counter>Y</use_counter>
    <counter_name>contador_dias</counter_name>
    <start_at>0</start_at>
    <increment_by>1</increment_by>
    <max_value>999999999</max_value>
    <attributes/>
    <GUI>
      <xloc>256</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Calcular a data e suas partes</name>
    <type>Calculator</type>
    <description>Soma o deslocamento a data base e extrai ano, mes, dia, trimestre e dia da semana. O Hop devolve o dia da semana de 1 a 7 comecando no domingo, entao subtrai 1 para ficar de 0 a 6, como o DDL exige.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <calculation>
      <field_name>data</field_name>
      <calc_type>ADD_DAYS</calc_type>
      <field_a>data_base</field_a>
      <field_b>offset_dias</field_b>
      <field_c/>
      <value_type>Date</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <conversion_mask/>
      <decimal_symbol/>
      <grouping_symbol/>
      <currency_symbol/>
      <remove>N</remove>
    </calculation>
    <calculation>
      <field_name>ano</field_name>
      <calc_type>YEAR_OF_DATE</calc_type>
      <field_a>data</field_a>
      <field_b/>
      <field_c/>
      <value_type>Integer</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <conversion_mask/>
      <decimal_symbol/>
      <grouping_symbol/>
      <currency_symbol/>
      <remove>N</remove>
    </calculation>
    <calculation>
      <field_name>mes</field_name>
      <calc_type>MONTH_OF_DATE</calc_type>
      <field_a>data</field_a>
      <field_b/>
      <field_c/>
      <value_type>Integer</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <conversion_mask/>
      <decimal_symbol/>
      <grouping_symbol/>
      <currency_symbol/>
      <remove>N</remove>
    </calculation>
    <calculation>
      <field_name>dia</field_name>
      <calc_type>DAY_OF_MONTH</calc_type>
      <field_a>data</field_a>
      <field_b/>
      <field_c/>
      <value_type>Integer</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <conversion_mask/>
      <decimal_symbol/>
      <grouping_symbol/>
      <currency_symbol/>
      <remove>N</remove>
    </calculation>
    <calculation>
      <field_name>trimestre</field_name>
      <calc_type>QUARTER_OF_DATE</calc_type>
      <field_a>data</field_a>
      <field_b/>
      <field_c/>
      <value_type>Integer</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <conversion_mask/>
      <decimal_symbol/>
      <grouping_symbol/>
      <currency_symbol/>
      <remove>N</remove>
    </calculation>
    <calculation>
      <field_name>dow_hop</field_name>
      <calc_type>DAY_OF_WEEK</calc_type>
      <field_a>data</field_a>
      <field_b/>
      <field_c/>
      <value_type>Integer</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <conversion_mask/>
      <decimal_symbol/>
      <grouping_symbol/>
      <currency_symbol/>
      <remove>N</remove>
    </calculation>
    <calculation>
      <field_name>dia_da_semana</field_name>
      <calc_type>SUBTRACT</calc_type>
      <field_a>dow_hop</field_a>
      <field_b>um</field_b>
      <field_c/>
      <value_type>Integer</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <conversion_mask/>
      <decimal_symbol/>
      <grouping_symbol/>
      <currency_symbol/>
      <remove>N</remove>
    </calculation>
    <fail_if_no_file>Y</fail_if_no_file>
    <attributes/>
    <GUI>
      <xloc>416</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Montar rotulos de texto</name>
    <type>Janino</type>
    <description>Monta o ano_mes no formato AAAA-MM, as chaves de texto usadas na traducao e a marca de fim de semana.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <formula>
      <field_name>ano_mes</field_name>
      <formula_string>new java.text.SimpleDateFormat("yyyy-MM").format(data)</formula_string>
      <value_type>String</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>mes_chave</field_name>
      <formula_string>new java.text.SimpleDateFormat("MM").format(data)</formula_string>
      <value_type>String</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>dia_semana_chave</field_name>
      <formula_string>String.valueOf(dia_da_semana.longValue())</formula_string>
      <value_type>String</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <formula>
      <field_name>eh_fim_de_semana</field_name>
      <formula_string>dia_da_semana.longValue() == 0 || dia_da_semana.longValue() == 6</formula_string>
      <value_type>Boolean</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <attributes/>
    <GUI>
      <xloc>576</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Traduzir o mes</name>
    <type>ValueMapper</type>
    <description>Tabela de para do numero do mes para o nome em portugues. Fica visivel na pipeline em vez de escondida em SQL.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <field_to_use>mes_chave</field_to_use>
    <target_field>nome_mes</target_field>
    <non_match_default/>
    <fields>
      <field>
        <source_value>01</source_value>
        <target_value>janeiro</target_value>
      </field>
      <field>
        <source_value>02</source_value>
        <target_value>fevereiro</target_value>
      </field>
      <field>
        <source_value>03</source_value>
        <target_value>marco</target_value>
      </field>
      <field>
        <source_value>04</source_value>
        <target_value>abril</target_value>
      </field>
      <field>
        <source_value>05</source_value>
        <target_value>maio</target_value>
      </field>
      <field>
        <source_value>06</source_value>
        <target_value>junho</target_value>
      </field>
      <field>
        <source_value>07</source_value>
        <target_value>julho</target_value>
      </field>
      <field>
        <source_value>08</source_value>
        <target_value>agosto</target_value>
      </field>
      <field>
        <source_value>09</source_value>
        <target_value>setembro</target_value>
      </field>
      <field>
        <source_value>10</source_value>
        <target_value>outubro</target_value>
      </field>
      <field>
        <source_value>11</source_value>
        <target_value>novembro</target_value>
      </field>
      <field>
        <source_value>12</source_value>
        <target_value>dezembro</target_value>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>736</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Traduzir o dia da semana</name>
    <type>ValueMapper</type>
    <description>Tabela de para do numero do dia da semana (0 = domingo) para o nome em portugues.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <field_to_use>dia_semana_chave</field_to_use>
    <target_field>nome_dia_semana</target_field>
    <non_match_default/>
    <fields>
      <field>
        <source_value>0</source_value>
        <target_value>domingo</target_value>
      </field>
      <field>
        <source_value>1</source_value>
        <target_value>segunda-feira</target_value>
      </field>
      <field>
        <source_value>2</source_value>
        <target_value>terca-feira</target_value>
      </field>
      <field>
        <source_value>3</source_value>
        <target_value>quarta-feira</target_value>
      </field>
      <field>
        <source_value>4</source_value>
        <target_value>quinta-feira</target_value>
      </field>
      <field>
        <source_value>5</source_value>
        <target_value>sexta-feira</target_value>
      </field>
      <field>
        <source_value>6</source_value>
        <target_value>sabado</target_value>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>896</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Gravar gold.dim_data</name>
    <type>TableOutput</type>
    <description>Grava as 2254 linhas. Os campos auxiliares (data_base, um, offset_dias, dow_hop, mes_chave, dia_semana_chave) nao entram porque a gravacao lista os campos um a um.</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <commit>1000</commit>
    <connection>postgres</connection>
    <fields>
      <field>
        <column_name>data</column_name>
        <stream_name>data</stream_name>
      </field>
      <field>
        <column_name>ano</column_name>
        <stream_name>ano</stream_name>
      </field>
      <field>
        <column_name>mes</column_name>
        <stream_name>mes</stream_name>
      </field>
      <field>
        <column_name>dia</column_name>
        <stream_name>dia</stream_name>
      </field>
      <field>
        <column_name>ano_mes</column_name>
        <stream_name>ano_mes</stream_name>
      </field>
      <field>
        <column_name>nome_mes</column_name>
        <stream_name>nome_mes</stream_name>
      </field>
      <field>
        <column_name>trimestre</column_name>
        <stream_name>trimestre</stream_name>
      </field>
      <field>
        <column_name>dia_da_semana</column_name>
        <stream_name>dia_da_semana</stream_name>
      </field>
      <field>
        <column_name>nome_dia_semana</column_name>
        <stream_name>nome_dia_semana</stream_name>
      </field>
      <field>
        <column_name>eh_fim_de_semana</column_name>
        <stream_name>eh_fim_de_semana</stream_name>
      </field>
    </fields>
    <ignore_errors>N</ignore_errors>
    <only_when_have_rows>N</only_when_have_rows>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_field/>
    <partitioning_monthly>Y</partitioning_monthly>
    <return_field/>
    <return_keys>N</return_keys>
    <schema>gold</schema>
    <specify_fields>Y</specify_fields>
    <table>dim_data</table>
    <tablename_field/>
    <tablename_in_field>N</tablename_in_field>
    <tablename_in_table>Y</tablename_in_table>
    <truncate>N</truncate>
    <use_batch>Y</use_batch>
    <attributes/>
    <GUI>
      <xloc>1056</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>
