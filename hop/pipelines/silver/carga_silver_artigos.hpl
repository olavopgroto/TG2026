<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>carga_silver_artigos</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Le o artigos_metadados.csv, busca o id_evento em silver.eventos e grava em silver.artigos</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/09/22 18:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/09/22 18:00:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>Ler artigos_metadados</from>
      <to>Buscar id_evento</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Buscar id_evento</from>
      <to>Gravar silver.artigos</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Buscar id_evento</name>
    <type>DBLookup</type>
    <description>Traz o id_evento de silver.eventos casando pelo nome_evento. Linha sem correspondencia segue com id nulo e quebra no Table output, de proposito</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <cache>Y</cache>
    <cache_load_all>Y</cache_load_all>
    <cache_size>0</cache_size>
    <connection>postgres</connection>
    <lookup>
      <eat_row_on_failure>N</eat_row_on_failure>
      <fail_on_multiple>N</fail_on_multiple>
      <key>
        <condition>=</condition>
        <field>nome_evento</field>
        <name>nome_evento</name>
      </key>
      <schema>silver</schema>
      <table>eventos</table>
      <value>
        <name>id_evento</name>
        <rename>id_evento</rename>
        <trim_type>none</trim_type>
        <type>Integer</type>
      </value>
    </lookup>
    <attributes/>
    <GUI>
      <xloc>288</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Gravar silver.artigos</name>
    <type>TableOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <commit>1000</commit>
    <connection>postgres</connection>
    <fields>
      <field>
        <column_name>id_evento</column_name>
        <stream_name>id_evento</stream_name>
      </field>
      <field>
        <column_name>artigo</column_name>
        <stream_name>artigo_wikipedia</stream_name>
      </field>
      <field>
        <column_name>eh_principal</column_name>
        <stream_name>eh_principal</stream_name>
      </field>
      <field>
        <column_name>alias_de</column_name>
        <stream_name>alias_de</stream_name>
      </field>
      <field>
        <column_name>posicao_ranking</column_name>
        <stream_name>posicao_ranking</stream_name>
      </field>
      <field>
        <column_name>media_base</column_name>
        <stream_name>media_base</stream_name>
      </field>
      <field>
        <column_name>media_pico</column_name>
        <stream_name>media_pico</stream_name>
      </field>
      <field>
        <column_name>razao_amplificacao</column_name>
        <stream_name>razao_amplificacao</stream_name>
      </field>
      <field>
        <column_name>data_criacao</column_name>
        <stream_name>data_criacao</stream_name>
      </field>
    </fields>
    <ignore_errors>N</ignore_errors>
    <only_when_have_rows>N</only_when_have_rows>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_monthly>Y</partitioning_monthly>
    <return_keys>N</return_keys>
    <schema>silver</schema>
    <specify_fields>Y</specify_fields>
    <table>artigos</table>
    <tablename_in_field>N</tablename_in_field>
    <tablename_in_table>Y</tablename_in_table>
    <truncate>N</truncate>
    <use_batch>Y</use_batch>
    <attributes/>
    <GUI>
      <xloc>496</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Ler artigos_metadados</name>
    <type>CSVInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <filename>/project/dados_referencia/artigos_metadados.csv</filename>
    <filename_field/>
    <rownum_field/>
    <include_filename>N</include_filename>
    <separator>,</separator>
    <enclosure>"</enclosure>
    <header>Y</header>
    <buffer_size>50000</buffer_size>
    <schemaDefinition/>
    <lazy_conversion>N</lazy_conversion>
    <add_filename_result>N</add_filename_result>
    <parallel>N</parallel>
    <newline_possible>N</newline_possible>
    <encoding>UTF-8</encoding>
    <fields>
      <field>
        <name>nome_evento</name>
        <type>String</type>
        <format/>
        <currency>¤</currency>
        <decimal>.</decimal>
        <group>,</group>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>categoria</name>
        <type>String</type>
        <format/>
        <currency>¤</currency>
        <decimal>.</decimal>
        <group>,</group>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>artigo_wikipedia</name>
        <type>String</type>
        <format/>
        <currency>¤</currency>
        <decimal>.</decimal>
        <group>,</group>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>eh_principal</name>
        <type>Boolean</type>
        <format/>
        <currency>¤</currency>
        <decimal>.</decimal>
        <group>,</group>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>alias_de</name>
        <type>String</type>
        <format/>
        <currency>¤</currency>
        <decimal>.</decimal>
        <group>,</group>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>posicao_ranking</name>
        <type>Integer</type>
        <format>#</format>
        <currency>¤</currency>
        <decimal>.</decimal>
        <group>,</group>
        <length>-1</length>
        <precision>0</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>media_base</name>
        <type>Number</type>
        <format>#.#####</format>
        <currency>¤</currency>
        <decimal>.</decimal>
        <group>,</group>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>media_pico</name>
        <type>Number</type>
        <format>#.#####</format>
        <currency>¤</currency>
        <decimal>.</decimal>
        <group>,</group>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>razao_amplificacao</name>
        <type>Number</type>
        <format>#.#####</format>
        <currency>¤</currency>
        <decimal>.</decimal>
        <group>,</group>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>data_criacao</name>
        <type>Date</type>
        <format>yyyy-MM-dd</format>
        <currency>¤</currency>
        <decimal>.</decimal>
        <group>,</group>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>primeiro_dia_com_views</name>
        <type>String</type>
        <format/>
        <currency>¤</currency>
        <decimal>.</decimal>
        <group>,</group>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
    </fields>
    <attributes/>
    <GUI>
      <xloc>96</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>
