<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>carga_silver_cobertura</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Abre o payload JSON da cobertura da Bronze em uma linha por evento, pais e dia, e grava as duas tabelas: a granular por pais e a agregada por evento e dia</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/09/22 21:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/09/22 21:00:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>Abrir payload da cobertura</from>
      <to>Gravar silver.cobertura_diaria_pais</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Abrir payload da cobertura</from>
      <to>Agrupar os 10 paises</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Agrupar os 10 paises</from>
      <to>Gravar silver.cobertura_diaria</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Abrir payload da cobertura</name>
    <type>TableInput</type>
    <description>Cada linha da Bronze guarda 91 dias dentro de um JSON. Aqui o payload e aberto em uma linha por dia, usando jsonb_array_elements. O ORDER BY e obrigatorio por causa do Group by mais adiante</description>
    <distribute>N</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>postgres</connection>
    <sql>SELECT e.id_evento,
       c.pais_cobertura,
       (x-&gt;&gt;'date')::date                          AS dia,
       ((x-&gt;&gt;'date')::date - e.data_evento)        AS dias_desde_evento,
       (x-&gt;&gt;'count')::int                          AS materias,
       (x-&gt;&gt;'total_count')::bigint                 AS materias_total,
       (x-&gt;&gt;'ratio')::numeric                      AS proporcao,
       CASE WHEN COALESCE((x-&gt;&gt;'count')::int, 0) &gt; 0 THEN 1 END AS pais_com_materia
FROM bronze.cobertura_midia_bruto c
JOIN silver.eventos e ON e.nome_evento = c.evento_referencia
CROSS JOIN LATERAL jsonb_array_elements(c.payload) AS x
ORDER BY e.id_evento, (x-&gt;&gt;'date')::date, c.pais_cobertura</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <attributes/>
    <GUI>
      <xloc>112</xloc>
      <yloc>160</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Gravar silver.cobertura_diaria_pais</name>
    <type>TableOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <commit>1000</commit>
    <connection>postgres</connection>
    <fields>
      <field>
        <column_name>id_evento</column_name>
        <stream_name>id_evento</stream_name>
      </field>
      <field>
        <column_name>pais_cobertura</column_name>
        <stream_name>pais_cobertura</stream_name>
      </field>
      <field>
        <column_name>dia</column_name>
        <stream_name>dia</stream_name>
      </field>
      <field>
        <column_name>dias_desde_evento</column_name>
        <stream_name>dias_desde_evento</stream_name>
      </field>
      <field>
        <column_name>materias</column_name>
        <stream_name>materias</stream_name>
      </field>
      <field>
        <column_name>materias_total</column_name>
        <stream_name>materias_total</stream_name>
      </field>
      <field>
        <column_name>proporcao</column_name>
        <stream_name>proporcao</stream_name>
      </field>
    </fields>
    <ignore_errors>N</ignore_errors>
    <only_when_have_rows>N</only_when_have_rows>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_monthly>Y</partitioning_monthly>
    <return_keys>N</return_keys>
    <schema>silver</schema>
    <specify_fields>Y</specify_fields>
    <table>cobertura_diaria_pais</table>
    <tablename_in_field>N</tablename_in_field>
    <tablename_in_table>Y</tablename_in_table>
    <truncate>N</truncate>
    <use_batch>Y</use_batch>
    <attributes/>
    <GUI>
      <xloc>560</xloc>
      <yloc>64</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Agrupar os 10 paises</name>
    <type>GroupBy</type>
    <description>Soma os 10 paises de cada dia. paises_com_materia conta quantos deles publicaram algo</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <all_rows>N</all_rows>
    <ignore_aggregate>N</ignore_aggregate>
    <field_ignore/>
    <group>
      <field>
        <name>id_evento</name>
      </field>
      <field>
        <name>dia</name>
      </field>
      <field>
        <name>dias_desde_evento</name>
      </field>
    </group>
    <fields>
      <field>
        <aggregate>materias_soma</aggregate>
        <subject>materias</subject>
        <type>SUM</type>
        <valuefield/>
      </field>
      <field>
        <aggregate>materias_total_soma</aggregate>
        <subject>materias_total</subject>
        <type>SUM</type>
        <valuefield/>
      </field>
      <field>
        <aggregate>paises_com_materia</aggregate>
        <subject>pais_com_materia</subject>
        <type>COUNT_ALL</type>
        <valuefield/>
      </field>
    </fields>
    <add_linenr>N</add_linenr>
    <linenr_fieldname/>
    <give_back_row>N</give_back_row>
    <attributes/>
    <GUI>
      <xloc>560</xloc>
      <yloc>256</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Gravar silver.cobertura_diaria</name>
    <type>TableOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <commit>1000</commit>
    <connection>postgres</connection>
    <fields>
      <field>
        <column_name>id_evento</column_name>
        <stream_name>id_evento</stream_name>
      </field>
      <field>
        <column_name>dia</column_name>
        <stream_name>dia</stream_name>
      </field>
      <field>
        <column_name>dias_desde_evento</column_name>
        <stream_name>dias_desde_evento</stream_name>
      </field>
      <field>
        <column_name>materias</column_name>
        <stream_name>materias_soma</stream_name>
      </field>
      <field>
        <column_name>materias_total</column_name>
        <stream_name>materias_total_soma</stream_name>
      </field>
      <field>
        <column_name>paises_com_materia</column_name>
        <stream_name>paises_com_materia</stream_name>
      </field>
    </fields>
    <ignore_errors>N</ignore_errors>
    <only_when_have_rows>N</only_when_have_rows>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_monthly>Y</partitioning_monthly>
    <return_keys>N</return_keys>
    <schema>silver</schema>
    <specify_fields>Y</specify_fields>
    <table>cobertura_diaria</table>
    <tablename_in_field>N</tablename_in_field>
    <tablename_in_table>Y</tablename_in_table>
    <truncate>N</truncate>
    <use_batch>Y</use_batch>
    <attributes/>
    <GUI>
      <xloc>784</xloc>
      <yloc>256</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>
