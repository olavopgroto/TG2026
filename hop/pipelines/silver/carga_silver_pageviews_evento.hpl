<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>carga_silver_pageviews_evento</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Agrega a grade por evento, dia, acesso e agente, gerando as duas curvas: a do artigo principal (somado com seus titulos anteriores) e a do conjunto de artigos do evento</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/09/22 20:00:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/09/22 20:00:00.000</modified_date>
  </info>
  <notepads>
  </notepads>
  <order>
    <hop>
      <from>Ler grade por artigo</from>
      <to>Separar familia do principal</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Separar familia do principal</from>
      <to>Agrupar por evento e dia</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Agrupar por evento e dia</from>
      <to>Gravar silver.pageviews_diario_evento</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Ler grade por artigo</name>
    <type>TableInput</type>
    <description>Le a grade ja carregada e marca quais linhas pertencem a familia do artigo principal (o proprio principal e seus titulos anteriores). O ORDER BY e obrigatorio: o Group by trabalha com a entrada ordenada pelos campos de agrupamento</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>postgres</connection>
    <sql>SELECT p.id_evento,
       p.dia,
       p.dias_desde_evento,
       p.tipo_acesso,
       p.tipo_agente,
       p.visualizacoes,
       (a.eh_principal OR a.alias_de IS NOT NULL) AS eh_familia_principal
FROM silver.pageviews_diario_artigo p
JOIN silver.artigos a ON a.id_artigo = p.id_artigo
ORDER BY p.id_evento, p.dia, p.dias_desde_evento, p.tipo_acesso, p.tipo_agente</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <attributes/>
    <GUI>
      <xloc>112</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Separar familia do principal</name>
    <type>Janino</type>
    <description>Cria um campo que so tem valor quando a linha e do artigo principal ou de um titulo anterior dele. Assim a mesma soma serve para as duas curvas: uma soma este campo, a outra soma todas as linhas</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <formula>
      <field_name>views_familia_principal</field_name>
      <formula_string>eh_familia_principal ? visualizacoes : (Long)null</formula_string>
      <value_type>Integer</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <attributes/>
    <GUI>
      <xloc>320</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Agrupar por evento e dia</name>
    <type>GroupBy</type>
    <description>Soma ignorando nulos: quando nenhum artigo tem dado no dia, o resultado fica nulo, que e a leitura correta segundo a regra de zero e nulo</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <all_rows>N</all_rows>
    <ignore_aggregate>N</ignore_aggregate>
    <field_ignore/>
    <group>
      <field>
        <name>id_evento</name>
      </field>
      <field>
        <name>dia</name>
      </field>
      <field>
        <name>dias_desde_evento</name>
      </field>
      <field>
        <name>tipo_acesso</name>
      </field>
      <field>
        <name>tipo_agente</name>
      </field>
    </group>
    <fields>
      <field>
        <aggregate>views_principal</aggregate>
        <subject>views_familia_principal</subject>
        <type>SUM</type>
        <valuefield/>
      </field>
      <field>
        <aggregate>views_conjunto</aggregate>
        <subject>visualizacoes</subject>
        <type>SUM</type>
        <valuefield/>
      </field>
      <field>
        <aggregate>artigos_com_dado</aggregate>
        <subject>visualizacoes</subject>
        <type>COUNT_ALL</type>
        <valuefield/>
      </field>
    </fields>
    <add_linenr>N</add_linenr>
    <linenr_fieldname/>
    <give_back_row>N</give_back_row>
    <attributes/>
    <GUI>
      <xloc>512</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Gravar silver.pageviews_diario_evento</name>
    <type>TableOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <commit>1000</commit>
    <connection>postgres</connection>
    <fields>
      <field>
        <column_name>id_evento</column_name>
        <stream_name>id_evento</stream_name>
      </field>
      <field>
        <column_name>dia</column_name>
        <stream_name>dia</stream_name>
      </field>
      <field>
        <column_name>dias_desde_evento</column_name>
        <stream_name>dias_desde_evento</stream_name>
      </field>
      <field>
        <column_name>tipo_acesso</column_name>
        <stream_name>tipo_acesso</stream_name>
      </field>
      <field>
        <column_name>tipo_agente</column_name>
        <stream_name>tipo_agente</stream_name>
      </field>
      <field>
        <column_name>views_principal</column_name>
        <stream_name>views_principal</stream_name>
      </field>
      <field>
        <column_name>views_conjunto</column_name>
        <stream_name>views_conjunto</stream_name>
      </field>
      <field>
        <column_name>artigos_com_dado</column_name>
        <stream_name>artigos_com_dado</stream_name>
      </field>
    </fields>
    <ignore_errors>N</ignore_errors>
    <only_when_have_rows>N</only_when_have_rows>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_monthly>Y</partitioning_monthly>
    <return_keys>N</return_keys>
    <schema>silver</schema>
    <specify_fields>Y</specify_fields>
    <table>pageviews_diario_evento</table>
    <tablename_in_field>N</tablename_in_field>
    <tablename_in_table>Y</tablename_in_table>
    <truncate>N</truncate>
    <use_batch>Y</use_batch>
    <attributes/>
    <GUI>
      <xloc>736</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
  <attributes/>
</pipeline>
